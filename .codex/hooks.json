{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/harness.mjs hook SessionStart",
            "command_windows": "node tools/harness.mjs hook SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/harness.mjs hook PostToolUse",
            "command_windows": "node tools/harness.mjs hook PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/harness.mjs hook Stop",
            "command_windows": "node tools/harness.mjs hook Stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
