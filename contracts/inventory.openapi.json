          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "rejection_code": {
            "title": "Rejection Code",
            "type": "null"
          },
