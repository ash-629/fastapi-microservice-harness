              "REJECTED",
              "RELEASED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "product_id",
          "quantity",
          "status",
          "rejection_code"
        ],
        "title": "Reservation",
        "type": "object"
      }
    }
