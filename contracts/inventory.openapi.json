            "title": "Name",
            "type": "string"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "sku",
          "name",
          "available_qty",
          "updated_at"
