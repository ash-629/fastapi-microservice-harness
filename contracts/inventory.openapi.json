          "product_id": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Product Id",
            "type": "string"
          },
          "quantity": {
            "maximum": 99.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "Request",
        "type": "object"
      },
