{
  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "additionalProperties": {},
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],
        "type": "object"
      },
      "Product": {
        "properties": {
          "available_qty": {
            "format": "int32",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "available_qty",
          "name",
          "product_id",
          "sku",
          "updated_at"
        ],
        "type": "object"
      },
      "ProductPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array"
          },
          "limit": {
            "format": "int32",
            "type": "integer"
          },
          "offset": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "limit",
          "offset",
          "total"
        ],
        "type": "object"
      },
      "Request": {
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "maximum": 99,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "type": "object"
      },
      "Reservation": {
        "properties": {
          "order_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "type": "integer"
          },
          "rejection_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "RESERVED",
              "REJECTED",
              "RELEASED"
            ],
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "product_id",
          "quantity",
          "rejection_code",
          "status"
        ],
        "type": "object"
      }
    }
  },
