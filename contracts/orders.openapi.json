        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "additionalProperties": {},
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],
        "type": "object"
      },
      "Order": {
        "properties": {
          "cancel_requested_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "cancelled_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "needs_attention": {
            "type": "boolean"
          },
          "order_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "type": "integer"
          },
          "rejection_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "PENDING_INVENTORY",
              "CONFIRMED",
              "REJECTED",
              "CANCEL_PENDING",
              "CANCELLED"
            ],
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "needs_attention",
          "order_id",
          "product_id",
          "quantity",
          "rejection_code",
          "status",
          "updated_at"
        ],
        "type": "object"
      },
      "OrderPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "type": "array"
          },
          "limit": {
            "format": "int32",
            "type": "integer"
          },
          "offset": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "limit",
          "offset",
          "total"
        ],
        "type": "object"
      },
      "Request": {
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "maximum": 99,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "type": "object"
      }
    }
