<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>dev.orderstudio</groupId><artifactId>order-studio</artifactId><version>2.0.1</version><packaging>pom</packaging>
  <modules><module>services/common</module><module>services/inventory</module><module>services/orders</module></modules>
  <properties><java.version>21</java.version><springdoc.version>2.8.17</springdoc.version><sqlite.version>3.53.2.0</sqlite.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencyManagement><dependencies>
