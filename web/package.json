{
  "name": "harness-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "generate": "openapi-ts -i ../contracts/orders.openapi.json -c @hey-api/client-fetch -o src/api/generated/orders && openapi-ts -i ../contracts/inventory.openapi.json -c @hey-api/client-fetch -o src/api/generated/inventory",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "msw": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
